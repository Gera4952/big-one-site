AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.bigonegarage\.ru$ [NC]
  RewriteRule ^ https://bigonegarage.ru%{REQUEST_URI} [R=301,L]

  # Redirect only an explicit request so DirectoryIndex can still serve /.
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(prices|uslugi/[a-z0-9-]+)/?$ /$1.html [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml text/plain application/xml text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Vite changes the file name whenever these assets change.
<IfModule mod_headers.c>
  <FilesMatch "^index-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
