{
  "name": "bigone-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/ssr && node scripts/prepare-sites-build.mjs && node scripts/prerender.mjs",
    "build:root": "SITE_BASE_PATH=/ npm run build",
    "pack:html": "SITE_BASE_PATH=/ npm run build && node scripts/pack-html.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "start": "node server/app.mjs",
    "test": "node --test tests/mail.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "nodemailer": "^10.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
